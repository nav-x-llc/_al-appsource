{
  "type": "AppSource App",
  "templateUrl": "https://github.com/microsoft/AL-Go-AppSource@main",
  "appDependencyProbingPaths": [
    {
      "repo": "https://github.com/nav-x-llc/nav-x-library",
      "version": "latest",
      "release_status": "release",
      "projects": "*",
      "AuthTokenSecret": "githubToken"
    }
  ],
  "ghTokenWorkflow": "GhTokenWorkflow",
  "deployToTEST": {
    "EnvironmentName": "NAV-X_Internal_QA",
    "DependencyInstallMode": "upgrade",
    "Branches": [
      "internal-test"
    ],
    "continuousDeployment": true
  },
  "CICDPushBranches": [
    "main",
    "release/*",
    "feature/*",
    "internal-test"
  ],
  "CICDPullRequestBranches": [
    "main",
    "feature/*",
    "internal-test"
  ],
  "installOnlyReferencedApps": false,
  "useCompilerFolder": true
}
